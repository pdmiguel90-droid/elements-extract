/* ═══════════════════════════════════════════════════════════════════════════
   Elements Extract — Light Theme v2
   Diseño: acento único naranja · verde solo éxito · Open Sans
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Base / Tipografía ─────────────────────────────────────────────────── */
QWidget {
    background-color: #F6F7F9;
    color: #1F2329;
    font-family: 'Open Sans', 'Noto Sans', 'Cantarell', 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 400;
}
QMainWindow, QDialog {
    background-color: #F6F7F9;
}
QLabel {
    font-weight: 700;
    color: #1F2329;
    background: transparent;
}
QLabel[labelColor="normal"] {
    color: #1F2329;
    font-weight: 400;
}
QLabel[labelColor="muted"] {
    color: #6E7681;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.6px;
}
QLabel[labelColor="green"] {
    color: #1E9E6A;
    font-weight: 600;
}
QLabel[labelColor="accent"] {
    color: #D9700A;
    font-weight: 600;
}
QLabel[labelColor="title"] {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 4px;
    color: #D9700A;
    margin-bottom: 2px;
}

/* ── Superficies / Group Box ───────────────────────────────────────────── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E6EA;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    color: #1F2329;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    color: #D9700A;
}

/* ── Entradas ──────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 6px;
    padding: 7px 10px;
    color: #1F2329;
    selection-background-color: #D9700A;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border: 1px solid #AEB6C0;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #D9700A;
}
QLineEdit:disabled, QComboBox:disabled {
    color: #A3ABB5;
    border-color: #E5E8EC;
    background-color: #F0F2F4;
}
QScrollArea {
    background-color: transparent;
    border: none;
}
QFrame#sep {
    background-color: #E2E6EA;
}

/* ── Listas ────────────────────────────────────────────────────────────── */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 6px;
    padding: 4px;
    color: #1F2329;
    outline: none;
}
QListWidget:focus {
    border: 1px solid #D9700A;
}
QListWidget::item {
    padding: 7px 10px;
    margin: 1px 2px;
    border-radius: 5px;
    border: none;
    color: #3A414B;
}
QListWidget::item:hover {
    background-color: #F2F4F6;
    color: #1F2329;
}
QListWidget::item:selected {
    background-color: rgba(217, 112, 10, 9%);
    color: #B85D08;
    border-left: 2px solid #D9700A;
}
QListWidget::item:disabled {
    color: #A3ABB5;
}
/* Listas de modelos: éxito = verde (instalados), acento = naranja (online) */
QListWidget#localModelList::item:selected {
    background-color: rgba(30, 158, 106, 8%);
    color: #1E9E6A;
    border-left: 2px solid #1E9E6A;
}
QListWidget#onlineModelList::item:selected {
    background-color: rgba(217, 112, 10, 9%);
    color: #B85D08;
    border-left: 2px solid #D9700A;
}

/* ── Botones ───────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CFD5DC;
    border-radius: 7px;
    padding: 6px 14px;
    color: #2B313A;
    font-weight: 600;
    min-height: 22px;
    qproperty-iconSize: 14px 14px;
}
QPushButton:hover {
    background-color: #F2F4F6;
    border-color: #D9700A;
    color: #B85D08;
}
QPushButton:pressed {
    background-color: #D9700A;
    border-color: #D9700A;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #F0F2F4;
    border-color: #E5E8EC;
    color: #A3ABB5;
}
QPushButton:focus {
    border: 2px solid #D9700A;
}
QPushButton:default {
    border-color: #D9700A;
}

/* Acción principal — relleno naranja, más alto (jerarquía) */
QPushButton#extractButton {
    border: none;
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #E27614, stop:0.55 #D9700A, stop:1 #EE9335);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 12px 20px;
    min-height: 22px;
    qproperty-iconSize: 18px 18px;
}
QPushButton#extractButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #EC841F, stop:1 #F5A44E);
}
QPushButton#extractButton:pressed {
    background: #B25A00;
}
QPushButton#extractButton:disabled {
    background: #E8EBEE;
    border: 1px solid #E5E8EC;
    color: #A3ABB5;
}
QPushButton#extractButton:focus {
    border: 2px solid #F5A44E;
}

/* Acción de riesgo — misma altura que el primario */
QPushButton#cancelButton {
    border: 1px solid #D5A0A2;
    border-radius: 8px;
    background-color: transparent;
    color: #C0392F;
    font-weight: 600;
    padding: 12px 18px;
    min-height: 22px;
}
QPushButton#cancelButton:hover {
    background-color: rgba(214, 69, 69, 8%);
    border-color: #D64545;
}
QPushButton#cancelButton:pressed {
    background-color: #D64545;
    border-color: #D64545;
    color: #FFFFFF;
}
QPushButton#cancelButton:disabled {
    border-color: #E5E8EC;
    color: #A3ABB5;
    background-color: transparent;
}
QPushButton#cancelButton:focus {
    border: 2px solid #D64545;
}

/* Chips de selección rápida (VIDEO/AUDIO/SUBS/Limpiar / LOG) */
QPushButton#quickSelButton {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 13px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    min-height: 14px;
    color: #5C6470;
}
QPushButton#quickSelButton:hover {
    background-color: #F2F4F6;
    border-color: #D9700A;
    color: #D9700A;
}
QPushButton#quickSelButton:pressed {
    background-color: #D9700A;
    border-color: #D9700A;
    color: #FFFFFF;
}
QPushButton#quickSelButton:disabled {
    border-color: #E5E8EC;
    color: #A3ABB5;
}

/* ── CheckBox ──────────────────────────────────────────────────────────── */
QCheckBox {
    padding: 3px;
    color: #2E343D;
    font-weight: 400;
    spacing: 7px;
}
QCheckBox:hover {
    color: #1F2329;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background-color: #FFFFFF;
    border: 1px solid #AEB6C0;
    border-radius: 4px;
}
QCheckBox::indicator:hover {
    border: 1px solid #D9700A;
}
QCheckBox::indicator:checked {
    background-color: #D9700A;
    border: 1px solid #D9700A;
}
QCheckBox::indicator:disabled {
    border: 1px solid #E5E8EC;
    background-color: #F0F2F4;
}
QCheckBox::indicator:checked:disabled {
    background-color: #A3ABB5;
    border: 1px solid #C9D0D7;
}

/* ── ComboBox ──────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 6px;
    padding: 5px 30px 5px 10px;
    color: #1F2329;
    min-height: 18px;
}
QComboBox:hover {
    border: 1px solid #D9700A;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-left: 1px solid #E2E6EA;
    width: 26px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 6px;
    color: #1F2329;
    selection-background-color: rgba(217, 112, 10, 9%);
    selection-color: #B85D08;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

/* ── ProgressBar ───────────────────────────────────────────────────────── */
QProgressBar {
    border: 1px solid #D3D9E0;
    border-radius: 6px;
    background-color: #FFFFFF;
    text-align: center;
    color: #2E343D;
    font-size: 11px;
    font-weight: 600;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #D9700A, stop:1 #EE9335);
    border-radius: 5px;
}

/* ── Menús ─────────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #F6F7F9;
    color: #5C6470;
    border-bottom: 1px solid #E2E6EA;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 5px;
    font-weight: 600;
}
QMenuBar::item:selected {
    background-color: rgba(217, 112, 10, 9%);
    color: #D9700A;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 7px;
    color: #2B313A;
    padding: 5px;
}
QMenu::item {
    padding: 7px 24px;
    border-radius: 5px;
    font-weight: 400;
}
QMenu::item:selected {
    background-color: rgba(217, 112, 10, 9%);
    color: #B85D08;
}
QMenu::separator {
    height: 1px;
    background-color: #E2E6EA;
    margin: 5px 8px;
}

/* ── StatusBar ─────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #F6F7F9;
    color: #6E7681;
    font-size: 11px;
    border-top: 1px solid #E2E6EA;
}

/* ── Tabs ──────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #D3D9E0;
    border-radius: 8px;
    background-color: #F6F7F9;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #6E7681;
    padding: 8px 18px;
    border: 1px solid transparent;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background-color: #F6F7F9;
    color: #D9700A;
    border: 1px solid #D3D9E0;
    border-bottom: 2px solid #D9700A;
    font-weight: 700;
}
QTabBar::tab:hover:!selected {
    background-color: #FFFFFF;
    color: #3A414B;
}

/* ── Splitter ──────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E2E6EA;
}
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical   { height: 3px; }
QSplitter::handle:hover {
    background-color: #D9700A;
}

/* ── Scrollbars ────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: #CBD2D9;
    min-height: 26px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #D9700A;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: #CBD2D9;
    min-width: 26px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #D9700A;
}
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ── ToolTip ───────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #FFFFFF;
    color: #1F2329;
    border: 1px solid #D9700A;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Text Browser (Ayuda) ──────────────────────────────────────────────── */
QTextBrowser {
    background-color: #FFFFFF;
    color: #3A414B;
    border: 1px solid #D3D9E0;
    border-radius: 8px;
    padding: 16px;
    font-size: 13px;
}
QTextBrowser a { color: #D9700A; text-decoration: none; }
QTextBrowser a:hover { color: #B85D08; text-decoration: underline; }
QTextBrowser b { color: #B85D08; font-weight: 700; }
QTextBrowser h2 {
    color: #D9700A;
    font-size: 16px;
    font-weight: 700;
    border-bottom: 1px solid #E2E6EA;
    padding-bottom: 4px;
    margin-top: 10px;
}
QTextBrowser h3 {
    color: #1F2329;
    font-size: 13px;
    font-weight: 700;
    margin-top: 8px;
}
QTextBrowser td { padding: 3px 12px 3px 0; }

/* ── About Dialog ──────────────────────────────────────────────────────── */
QLabel#appLogo {
    background: transparent;
}
QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 4px;
    color: #D9700A;
}
QLabel#appVersion {
    font-size: 12px;
    color: #6E7681;
    font-weight: 400;
}
QLabel#key {
    color: #6E7681;
    font-weight: 400;
    font-size: 12px;
}
QLabel#value {
    color: #1F2329;
    font-weight: 400;
    font-size: 12px;
}
QLabel#value[link="true"] {
    color: #B85D08;
}
QLabel#value[link="true"]:hover {
    color: #D9700A;
    text-decoration: underline;
}
QLabel#sectionTitle {
    color: #6E7681;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}
QLabel#tech {
    background-color: #FFFFFF;
    border: 1px solid #D3D9E0;
    border-radius: 7px;
    padding: 9px 14px;
    font-size: 11px;
    font-weight: 600;
    color: #3A414B;
    min-width: 74px;
}
QLabel#copy {
    font-size: 10px;
    color: #A3ABB5;
    font-weight: 400;
}